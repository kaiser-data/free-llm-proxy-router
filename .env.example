# free-llm-proxy-router — API keys
#
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# Keys are loaded in this order (first match wins):
#   1. Real environment variable (export KEY=...)
#   2. .env in the project directory  ← this file
#   3. ~/.free-llm-proxy-router/.secrets
#
# .env is gitignored — never commit real keys.
# Leave unused providers blank; they will be skipped.
#
# All providers below are truly free with recharging rate limits —
# no one-time credits, no credit card required.

# Groq — fastest inference, all models free, limits reset daily
# Keys:   https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio (Gemini) — 1500 req/day, 1M token context, resets midnight PT
# Keys:   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter — 50+ free models (pricing == "0"), always available
# Keys:   https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# GitHub Models — free with any GitHub account, limits reset per minute/day
# Keys:   https://github.com/settings/tokens  (any PAT works)
GITHUB_TOKEN=

# Cerebras — hardware-accelerated inference, free tier, limits reset
# Keys:   https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Hugging Face Inference — 300 calls/hour (resets hourly), warm models only
# Keys:   https://huggingface.co/settings/tokens
HF_API_KEY=

# Mistral AI — 2 RPM free tier (resets), good for occasional use
# Keys:   https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# NVIDIA NIM — free credits that recharge monthly, 40 RPM, 200+ models
# Keys:   https://build.nvidia.com/settings/api-key
NVIDIA_API_KEY=

# Cohere — 1000 req/month free forever (resets monthly, no credit card)
# Keys:   https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Ollama — local models, no key needed
# Set enabled: true in config.yaml and install from https://ollama.com
# (LM Studio, llama.cpp, Jan, GPT4All, KoboldCpp, llamafile and Text Generation WebUI are
#  also in config.yaml as local providers; they need no key either.)

# ---------------------------------------------------------------------------
# More free tiers from free-llm.com (all shipped disabled in config.yaml).
# Set the key here, then set enabled: true for that provider in config.yaml.
# Some of these list paid models too: see the "Scan: mixed" notes in config.yaml.
# Limits and sign-up rules change often; check free-llm.com before relying on one.
# ---------------------------------------------------------------------------

# Multiple accounts: add GROQ_API_KEY_2 ... GROQ_API_KEY_9 (same pattern for any key
# below) and the router uses the next key on a 429.

# Z.AI (GLM) — Flash models, ~1,000 req/day
# Keys:   https://z.ai/
ZAI_API_KEY=

# ModelScope — 2,000 req/day total, phone verification
# Keys:   https://modelscope.cn
MODELSCOPE_API_KEY=

# Hetzner Inference API — free while experimental
# Keys:   https://experiments.hetzner.com/inference
HETZNER_INFERENCE_API_KEY=

# LLM7.io — free token, 100K tokens/day
# Keys:   https://dash.llm7.io
LLM7_API_KEY=

# Pollinations.ai — free API key (anonymous access removed)
# Keys:   https://pollinations.ai
POLLINATIONS_API_KEY=

# Kilo AI Gateway — 200 req/hour on free models
# Keys:   https://kilo.ai/gateway
KILO_API_KEY=

# Routeway — :free models, 200 req/day
# Keys:   https://routeway.ai/
ROUTEWAY_API_KEY=

# Requesty — free models, 200 req/day (new orgs)
# Keys:   https://requesty.ai/
REQUESTY_API_KEY=

# Onomeo — 30 free-model calls every 5 hours
# Keys:   https://onomeo.com
ONOMEO_API_KEY=

# OVH AI Endpoints — free anonymous access; a key switches to pay-as-you-go
# Keys:   https://endpoints.ai.cloud.ovh.net/
OVH_AI_ENDPOINTS_ACCESS_TOKEN=

# SiliconFlow — free models after identity verification
# Keys:   https://siliconflow.com/pricing
SILICONFLOW_API_KEY=

# Nous Portal — free models
# Keys:   https://portal.nousresearch.com
NOUS_API_KEY=

# Api.Airforce — 1,000 req/day
# Keys:   https://api.airforce/
AIRFORCE_API_KEY=

# Cloudflare Workers AI — 10,000 neurons/day (also put your account ID into base_url)
# Keys:   https://dash.cloudflare.com/
CLOUDFLARE_API_KEY=

# Ollama Cloud — starter usage credits
# Keys:   https://ollama.com/cloud
OLLAMA_API_KEY=

# Aion Labs — daily free credit
# Keys:   https://www.aionlabs.ai/pricing/
AION_API_KEY=

# Token Harbor — weekly free allowance
# Keys:   https://tokenharbor.ai
TOKENHARBOR_API_KEY=

# IteraCompute — 30M tokens/month
# Keys:   https://iteracompute.com/free/
ITERACOMPUTE_API_KEY=

# BazaarLink — free units/day
# Keys:   https://bazaarlink.ai/free
BAZAARLINK_API_KEY=

# Vercel AI Gateway — ~$5/month credit
# Keys:   https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
